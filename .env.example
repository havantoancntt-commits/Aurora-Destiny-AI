# ========================================================
# AURORA DESTINY AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in development. Configure in Secrets for Production.
# NEVER commit real secret keys, credentials, or production tokens.
# ========================================================

# 1. APPLICATION ENVIRONMENT & NETWORKING
APP_ENV=production
NODE_ENV=production
PORT=3000
BASE_URL=https://auroradestiny.ai
APP_URL=https://auroradestiny.ai
CORS_ORIGIN=https://auroradestiny.ai
ALLOWED_ORIGINS=https://auroradestiny.ai
TRUST_PROXY=1

# 2. AI ENGINE & GEMINI LLM
# Required for Gemini AI conversational synthesis and astrological reasoning.
# Server-side only (never prefix with VITE_).
GEMINI_API_KEY=

# 3. DATABASE CONFIGURATION (POSTGRESQL FOR PRODUCTION)
# In production, DATABASE_URL pointing to PostgreSQL is strictly required unless ALLOW_FILE_STORAGE_IN_PRODUCTION=true is explicitly set.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://aurora_user:secure_password@localhost:5432/aurora_destiny
DATABASE_REQUIRED_IN_PRODUCTION=true
ALLOW_FILE_STORAGE_IN_PRODUCTION=false

# PostgreSQL TLS / SSL Certificate Verification Policy:
# - In production: Certificate verification (rejectUnauthorized) defaults to true for MITM defense.
# - PGSSLMODE: 'require' | 'verify-ca' | 'verify-full' | 'disable'
# - DATABASE_SSL_REJECT_UNAUTHORIZED: 'true' (recommended for production) | 'false' (insecure override)
# - DATABASE_CA_CERT: Raw PEM CA certificate string (ideal for Vercel/Cloud environment secrets)
# - PGSSLROOTCERT: Path to CA root certificate file on disk
PGSSLMODE=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional Custom CA certificates (only required if connecting to private self-signed enterprise Postgres):
# DATABASE_CA_CERT=
# PGSSLROOTCERT=

# DATA_DIR: Local file directory for dev/test environments (default: ./data)
DATA_DIR=./data

# 4. REDIS DISTRIBUTED CACHE & SLIDING WINDOW RATE LIMITING
# In multi-instance / serverless production, REDIS_URL distributes rate limit state.
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED_IN_PRODUCTION=false
RATE_LIMIT_FAIL_CLOSED=false

# 5. CRYPTOGRAPHIC SECRETS & SIGNATURES
# Strictly required in production (minimum 32 characters, high-entropy random string, min 10 distinct characters).
# Used for HMAC token signing, tamper-evident seals, and signed download authorizations.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
APP_SECRET=
ALGORITHM_PROTECTION_SECRET=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# 6. INITIAL ADMINISTRATOR BOOTSTRAP (FIRST RUN)
# If omitted, a dynamic 256-bit emergency bootstrap key is printed to the secure console log on first launch.
ADMIN_EMAIL=
ADMIN_PASSWORD=
