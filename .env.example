# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL & ADMIN_PASSWORD: Required for initial administrator account bootstrap.
# If not provided, an initial secure bootstrap key is generated on first startup and logged to console.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# DATA_DIR: Directory for persistent database storage (default: ./data)
DATA_DIR=

# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://user:pass@host:5432/dbname)
# If omitted, defaults to durable atomic file repository in DATA_DIR with auto-migrations
DATABASE_URL=

# REDIS_URL: Redis connection string for distributed sliding-window rate limiting (e.g. redis://host:6379)
# If omitted, defaults to thread-safe in-memory sliding window store
REDIS_URL=

# ALLOWED_ORIGINS: Comma-separated list of exact allowed origins for CSRF protection in production (e.g. https://auroradestiny.ai)
ALLOWED_ORIGINS=
