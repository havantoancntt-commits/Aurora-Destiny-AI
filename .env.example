# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL & ADMIN_PASSWORD: Required for initial administrator account bootstrap.
# If not provided, an initial secure bootstrap key is generated on first startup and logged to console.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# DATA_DIR: Directory for persistent database storage (default: ./data)
DATA_DIR=

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins in production
ALLOWED_ORIGINS=

